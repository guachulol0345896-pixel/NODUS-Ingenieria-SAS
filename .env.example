# ---------------------------------------------------------------------------
# NODUS — Variables de entorno
# Copia este archivo como .env y reemplaza los valores.
# ---------------------------------------------------------------------------

# Cadena de conexión a PostgreSQL.
# Opción A (recomendada, gratis): Neon -> https://neon.tech  (Connection string "Pooled")
#   postgresql://usuario:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# Opción B: PostgreSQL local con Docker -> docker compose up -d
#   postgresql://nodus:nodus@localhost:5432/nodus
DATABASE_URL="postgresql://nodus:nodus@localhost:5432/nodus"

# Clave para firmar los JWT de sesión. Mínimo 32 caracteres.
# Genera una con:  openssl rand -base64 32
JWT_SECRET="cambia-esta-clave-por-una-aleatoria-de-32-caracteres"

# Nombre visible de la aplicación
NEXT_PUBLIC_APP_NAME="NODUS"
